<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="mx.dentalcare.ui.controller.TratamientosController"
        spacing="20"
        styleClass="content">

    <HBox
            alignment="CENTER_LEFT"
            spacing="15">

        <VBox
                HBox.hgrow="ALWAYS"
                spacing="5">

            <Label
                    text="Tratamientos"
                    styleClass="page-title"/>

            <Label
                    text="Administra los tratamientos y servicios del consultorio."
                    styleClass="page-subtitle"/>

        </VBox>

        <HBox spacing="10">

            <Button
                    fx:id="nuevoButton"
                    text="+ Nuevo tratamiento"
                    styleClass="primary-button"/>

            <Button
                    fx:id="editarButton"
                    text="Editar"
                    styleClass="secondary-button"/>

            <Button
                    fx:id="estadoButton"
                    text="Desactivar"
                    styleClass="secondary-button"/>

        </HBox>

    </HBox>

    <HBox
            alignment="CENTER_LEFT"
            spacing="15">

        <TextField
                fx:id="buscarField"
                promptText="Buscar tratamiento..."
                prefWidth="300"
                styleClass="search-field"/>

        <Label
                fx:id="contadorTratamientosLabel"
                text="Total de tratamientos: 0"
                styleClass="page-subtitle"/>

    </HBox>

    <TableView
            fx:id="tratamientosTable"
            VBox.vgrow="ALWAYS"
            styleClass="treatments-table">

        <columns>

            <TableColumn
                    fx:id="idColumn"
                    text="ID"
                    prefWidth="70"/>

            <TableColumn
                    fx:id="nombreColumn"
                    text="Tratamiento"
                    prefWidth="220"/>

            <TableColumn
                    fx:id="descripcionColumn"
                    text="Descripción"
                    prefWidth="320"/>

            <TableColumn
                    fx:id="duracionColumn"
                    text="Duración"
                    prefWidth="120"/>

            <TableColumn
                    fx:id="precioColumn"
                    text="Precio"
                    prefWidth="130"/>

            <TableColumn
                    fx:id="estadoColumn"
                    text="Estado"
                    prefWidth="120"/>

        </columns>

    </TableView>

</VBox>