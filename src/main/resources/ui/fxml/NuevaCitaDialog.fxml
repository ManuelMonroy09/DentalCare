<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.dentalcare.ui.controller.NuevaCitaController"
      styleClass="appointment-dialog"
      spacing="16">

    <padding>
        <Insets top="26" right="30" bottom="24" left="30"/>
    </padding>

    <!-- Encabezado -->
    <VBox spacing="4" styleClass="appointment-header">
        <Label text="Nueva cita" styleClass="page-title"/>
        <Label text="Programa la atención del paciente y define los detalles de la cita."
               styleClass="page-subtitle"
               wrapText="true"/>
    </VBox>

    <!-- Información principal -->
    <VBox spacing="14" styleClass="appointment-section">
        <VBox spacing="2">
            <Label text="Información de la cita" styleClass="appointment-section-title"/>
            <Label text="Selecciona al paciente y establece cuándo se realizará la atención."
                   styleClass="appointment-section-subtitle"
                   wrapText="true"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Paciente" styleClass="form-label"/>
            <ComboBox fx:id="cmbPaciente"
                      promptText="Selecciona un paciente"
                      maxWidth="Infinity"
                      styleClass="form-control"/>
        </VBox>

        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="38" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="31" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="31" hgrow="ALWAYS"/>
            </columnConstraints>

            <VBox spacing="6" GridPane.columnIndex="0">
                <Label text="Fecha" styleClass="form-label"/>
                <DatePicker fx:id="dateFecha"
                            maxWidth="Infinity"
                            styleClass="form-control"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="1">
                <Label text="Hora de inicio" styleClass="form-label"/>
                <ComboBox fx:id="cmbHora"
                          promptText="Selecciona una hora"
                          maxWidth="Infinity"
                          styleClass="form-control"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="2">
                <Label text="Duración" styleClass="form-label"/>
                <ComboBox fx:id="cmbDuracion"
                          maxWidth="Infinity"
                          styleClass="form-control"/>
            </VBox>
        </GridPane>
    </VBox>

    <!-- Motivo y notas -->
    <VBox spacing="14" styleClass="appointment-section">
        <VBox spacing="2">
            <Label text="Detalles de la atención" styleClass="appointment-section-title"/>
            <Label text="Agrega el motivo de consulta y cualquier información útil para la atención."
                   styleClass="appointment-section-subtitle"
                   wrapText="true"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Motivo de consulta" styleClass="form-label"/>
            <TextField fx:id="txtMotivo"
                       promptText="Ej. Dolor intenso en la muela inferior derecha"
                       maxWidth="Infinity"
                       styleClass="form-control"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Notas" styleClass="form-label"/>
            <TextArea fx:id="txtNotas"
                      promptText="Notas adicionales de la cita..."
                      wrapText="true"
                      prefRowCount="3"
                      maxWidth="Infinity"
                      styleClass="form-textarea"/>
        </VBox>
    </VBox>

    <!-- Tratamientos -->
    <VBox spacing="14" styleClass="appointment-section">
        <VBox spacing="2">
            <Label text="Tratamientos" styleClass="appointment-section-title"/>
            <Label text="Agrega los tratamientos que se realizarán durante esta cita."
                   styleClass="appointment-section-subtitle"
                   wrapText="true"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="cmbTratamiento"
                      promptText="Selecciona un tratamiento"
                      maxWidth="Infinity"
                      HBox.hgrow="ALWAYS"
                      styleClass="form-control"/>
            <Button fx:id="btnAgregarTratamiento"
                    text="+ Agregar"
                    mnemonicParsing="false"
                    styleClass="secondary-button"/>
        </HBox>

        <ListView fx:id="lstTratamientos"
                  prefHeight="96"
                  maxWidth="Infinity"
                  styleClass="appointment-treatment-list"/>

        <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="appointment-total-row">
            <Label text="Total de tratamientos" styleClass="appointment-total-label"/>
            <Label fx:id="lblTotalTratamientos"
                   text="$0.00"
                   styleClass="appointment-total-value"/>
        </HBox>
    </VBox>

    <!-- Mensaje de validación -->
    <Label fx:id="lblError"
           managed="false"
           visible="false"
           wrapText="true"
           maxWidth="Infinity"
           styleClass="appointment-error"/>

    <!-- Acciones -->
    <HBox spacing="10"
          alignment="CENTER_RIGHT"
          styleClass="appointment-actions">
        <Button fx:id="btnCancelar"
                text="Cancelar"
                mnemonicParsing="false"
                styleClass="secondary-button"/>
        <Button fx:id="btnGuardar"
                text="Guardar cita"
                mnemonicParsing="false"
                styleClass="primary-button"/>
    </HBox>

</VBox>
