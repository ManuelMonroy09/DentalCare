<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="mx.dentalcare.ui.controller.DetalleCitaController"
        stylesheets="@../css/dentalcare.css"
        styleClass="dialog-root"
        spacing="18">

    <padding>
        <Insets
                top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <!-- TÍTULO -->

    <VBox spacing="4">

        <Label
                text="Detalle de cita"
                styleClass="dialog-title"/>

        <Label
                text="Información de la cita seleccionada."
                styleClass="page-subtitle"/>

    </VBox>


    <!-- PACIENTE -->

    <VBox spacing="5">

        <Label
                text="Paciente"
                styleClass="form-label"/>

        <Label
                fx:id="lblPaciente"
                text="-"
                styleClass="detail-value"/>

    </VBox>


    <!-- FECHA + HORARIO -->

    <HBox spacing="35">

        <VBox
                spacing="5"
                HBox.hgrow="ALWAYS">

            <Label
                    text="Fecha"
                    styleClass="form-label"/>

            <Label
                    fx:id="lblFecha"
                    text="-"
                    styleClass="detail-value"/>

        </VBox>


        <VBox
                spacing="5"
                HBox.hgrow="ALWAYS">

            <Label
                    text="Horario"
                    styleClass="form-label"/>

            <Label
                    fx:id="lblHorario"
                    text="-"
                    styleClass="detail-value"/>

        </VBox>

    </HBox>


    <!-- DURACIÓN + ESTADO -->

    <HBox spacing="35">

        <VBox
                spacing="5"
                HBox.hgrow="ALWAYS">

            <Label
                    text="Duración"
                    styleClass="form-label"/>

            <Label
                    fx:id="lblDuracion"
                    text="-"
                    styleClass="detail-value"/>

        </VBox>


        <VBox
                spacing="5"
                HBox.hgrow="ALWAYS">

            <Label
                    text="Estado"
                    styleClass="form-label"/>

            <Label
                    fx:id="lblEstado"
                    text="-"
                    styleClass="detail-status"/>

        </VBox>

    </HBox>


    <!-- MOTIVO -->

    <VBox spacing="5">

        <Label
                text="Motivo"
                styleClass="form-label"/>

        <Label
                fx:id="lblMotivo"
                text="-"
                wrapText="true"
                maxWidth="Infinity"
                styleClass="detail-value"/>

    </VBox>


    <!-- NOTAS -->

    <VBox
            spacing="5"
            VBox.vgrow="ALWAYS">

        <Label
                text="Notas"
                styleClass="form-label"/>

        <Label
                fx:id="lblNotas"
                text="-"
                wrapText="true"
                maxWidth="Infinity"
                VBox.vgrow="ALWAYS"
                styleClass="detail-notes"/>

    </VBox>


    <!-- BOTONES -->

    <HBox
            spacing="10"
            alignment="CENTER_RIGHT">

        <Button
                fx:id="btnEditar"
                text="Editar cita"
                mnemonicParsing="false"
                styleClass="primary-button"/>

        <Button
                fx:id="btnCerrar"
                text="Cerrar"
                mnemonicParsing="false"
                styleClass="secondary-button"/>

    </HBox>

</VBox>