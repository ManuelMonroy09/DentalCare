<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="mx.dentalcare.ui.controller.HistorialController"
        spacing="20"
        styleClass="content">

    <padding>
        <Insets top="5" right="0" bottom="5" left="0"/>
    </padding>

    <VBox spacing="5">
        <Label text="Historial clínico" styleClass="page-title"/>
        <Label text="Consulta y seguimiento de las atenciones realizadas en el consultorio." styleClass="page-subtitle"/>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField
                fx:id="buscarField"
                promptText="Buscar paciente, motivo o tratamiento..."
                prefWidth="320"
                styleClass="search-field"/>

        <ComboBox
                fx:id="pacienteCombo"
                promptText="Paciente"
                prefWidth="190"/>

        <ComboBox
                fx:id="tratamientoCombo"
                promptText="Tratamiento"
                prefWidth="190"/>

        <DatePicker
                fx:id="fechaDesdePicker"
                promptText="Desde"
                prefWidth="125"/>

        <DatePicker
                fx:id="fechaHastaPicker"
                promptText="Hasta"
                prefWidth="125"/>

        <Button
                fx:id="limpiarFiltrosButton"
                text="Limpiar"
                mnemonicParsing="false"
                styleClass="secondary-button"/>
    </HBox>

    <TableView
            fx:id="historialTable"
            VBox.vgrow="ALWAYS"
            styleClass="patients-table"
            onMouseClicked="#abrirDetalle">
        <columns>
            <TableColumn fx:id="fechaColumn" text="Fecha" prefWidth="105"/>
            <TableColumn fx:id="pacienteColumn" text="Paciente" prefWidth="190"/>
            <TableColumn fx:id="horarioColumn" text="Horario" prefWidth="145"/>
            <TableColumn fx:id="motivoColumn" text="Motivo de consulta" prefWidth="270"/>
            <TableColumn fx:id="tratamientosColumn" text="Tratamientos" prefWidth="260"/>
            <TableColumn fx:id="totalColumn" text="Total" prefWidth="110"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label fx:id="resumenLabel" text="0 consultas atendidas   ·   0 tratamientos   ·   Total: $0.00" styleClass="page-subtitle"/>
        <Label fx:id="vacioLabel" text="" styleClass="page-subtitle" HBox.hgrow="ALWAYS"/>
        <Button
                text="Ver detalle"
                mnemonicParsing="false"
                onAction="#abrirDetalle"
                styleClass="primary-button"/>
    </HBox>

</VBox>
