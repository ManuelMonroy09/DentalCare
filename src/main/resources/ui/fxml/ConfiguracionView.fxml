<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.dentalcare.ui.controller.ConfiguracionController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="standard-page">
    <content>
        <VBox spacing="16">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

            <VBox spacing="16" VBox.vgrow="NEVER" styleClass="standard-section">
                <VBox spacing="5">
                    <Label text="Configuración" styleClass="page-title"/>
                    <Label text="Personaliza los datos del consultorio y las herramientas de mantenimiento de DentalCare."
                           styleClass="page-subtitle" wrapText="true"/>
                </VBox>

                <VBox spacing="14" styleClass="standard-section">
                    <Label text="Datos del consultorio" styleClass="standard-section-title"/>
                    <Label text="Estos datos aparecerán en los recibos impresos para el paciente."
                           styleClass="standard-section-subtitle" wrapText="true"/>

                    <GridPane hgap="16" vgap="12">
                        <columnConstraints>
                            <javafx.scene.layout.ColumnConstraints minWidth="170" prefWidth="190"/>
                            <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Nombre del consultorio" styleClass="standard-form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNombreConsultorio" promptText="Ej. Clínica Dental Sonrisa" styleClass="form-control" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Odontólogo" styleClass="standard-form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtOdontologo" promptText="Nombre del odontólogo" styleClass="form-control" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Teléfono" styleClass="standard-form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtTelefono" promptText="Teléfono del consultorio" styleClass="form-control" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Correo" styleClass="standard-form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtEmail" promptText="correo@ejemplo.com" styleClass="form-control" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Dirección" styleClass="standard-form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtDireccion" promptText="Dirección del consultorio" styleClass="form-control" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <Label text="Pie del recibo" styleClass="standard-form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtPieRecibo" promptText="Mensaje que aparecerá al final del recibo" styleClass="form-control" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    </GridPane>

                    <HBox styleClass="standard-actions">
                        <Button text="Guardar configuración" onAction="#guardarConfiguracion" styleClass="primary-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="14" styleClass="standard-section">
                    <Label text="Respaldo y restauración" styleClass="standard-section-title"/>
                    <Label text="Los respaldos conservan los archivos de datos cifrados de DentalCare. Guarda una copia fuera de la carpeta de instalación."
                           styleClass="standard-section-subtitle" wrapText="true"/>
                    <HBox spacing="10" styleClass="standard-actions">
                        <Button text="Crear respaldo" onAction="#crearRespaldo" styleClass="primary-button"/>
                        <Button text="Respaldo automático" onAction="#crearRespaldoAutomatico" styleClass="primary-button"/>
                        <Button text="Restaurar respaldo" onAction="#restaurarRespaldo" styleClass="secondary-button"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button text="Abrir carpeta de datos" onAction="#abrirCarpetaDatos" styleClass="secondary-button"/>
                        <Button text="Abrir carpeta de respaldo" onAction="#abrirCarpetaRespaldo" styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="14" styleClass="standard-section">
                    <Label text="Información del sistema" styleClass="standard-section-title"/>
                    <Label text="Consulta la versión de DentalCare, la versión de Java y la ubicación de los datos locales."
                           styleClass="standard-section-subtitle" wrapText="true"/>
                    <HBox styleClass="standard-actions">
                        <Button text="Ver información" onAction="#mostrarInformacionSistema" styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="8" styleClass="standard-section">
                    <Label text="Recomendación" styleClass="standard-section-title"/>
                    <Label text="Realiza respaldos periódicos y conserva al menos una copia en otra ubicación. La restauración reemplaza los datos actuales por los incluidos en el respaldo."
                           styleClass="standard-section-subtitle" wrapText="true"/>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
