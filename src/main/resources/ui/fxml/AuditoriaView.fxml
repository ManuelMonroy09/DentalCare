<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.dentalcare.ui.controller.AuditoriaController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="standard-page">
    <content>
        <VBox spacing="16">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

            <VBox spacing="16" VBox.vgrow="ALWAYS" styleClass="standard-section">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="5">
                        <Label text="Auditoría" styleClass="page-title"/>
                        <Label text="Registro histórico de actividad del sistema" styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <VBox spacing="16">
                    <Label text="Filtros de actividad" styleClass="standard-section-title"/>
                    <GridPane hgap="16" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="95" prefWidth="105"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="80" prefWidth="90"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="75" prefWidth="85"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Usuario" styleClass="standard-form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="usuarioFiltro" maxWidth="1.7976931348623157E308" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Módulo" styleClass="standard-form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <ComboBox fx:id="moduloFiltro" maxWidth="1.7976931348623157E308" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <Label text="Acción" styleClass="standard-form-label" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
                        <ComboBox fx:id="accionFiltro" maxWidth="1.7976931348623157E308" GridPane.rowIndex="0" GridPane.columnIndex="5"/>

                        <Label text="Desde" styleClass="standard-form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="desdeFiltro" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Hasta" styleClass="standard-form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <DatePicker fx:id="hastaFiltro" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                        <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.rowIndex="1" GridPane.columnIndex="4" GridPane.columnSpan="2">
                            <Button text="Aplicar filtros" onAction="#aplicarFiltros" styleClass="primary-button"/>
                            <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="secondary-button"/>
                        </HBox>
                    </GridPane>
                </VBox>

                <VBox spacing="12" VBox.vgrow="ALWAYS">
                    <Label text="Actividad registrada" styleClass="standard-section-title"/>
                    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" minHeight="260"/>
                </VBox>

                <VBox spacing="12">
                    <Label text="Detalle de la operación" styleClass="standard-section-title"/>
                    <GridPane hgap="16" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="130" prefWidth="155"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="130" prefWidth="155"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Usuario" styleClass="standard-form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="detalleUsuario" text="-" styleClass="standard-value" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Rol" styleClass="standard-form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="detalleRol" text="-" styleClass="standard-value" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <Label text="Fecha y hora" styleClass="standard-form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="detalleFecha" text="-" styleClass="standard-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Módulo" styleClass="standard-form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label fx:id="detalleModulo" text="-" styleClass="standard-value" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                        <Label text="Acción" styleClass="standard-form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="detalleAccion" text="-" styleClass="standard-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Registro" styleClass="standard-form-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                        <Label fx:id="detalleEntidad" text="-" styleClass="standard-value" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                        <Label text="Resultado" styleClass="standard-form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="detalleResultado" text="-" styleClass="standard-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Descripción" styleClass="standard-form-label" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                        <Label fx:id="detalleDescripcion" text="-" styleClass="standard-value" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
                        <Label text="Valor anterior" styleClass="standard-form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="detalleAnterior" text="-" styleClass="standard-value" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                        <Label text="Valor nuevo" styleClass="standard-form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label fx:id="detalleNuevo" text="-" styleClass="standard-value" wrapText="true" GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                    </GridPane>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
