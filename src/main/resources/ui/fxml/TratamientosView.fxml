<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="mx.dentalcare.ui.controller.TratamientosController"
        spacing="16"
        fillWidth="true"
        styleClass="standard-page">
    <padding>
        <Insets top="24" right="26" bottom="24" left="26"/>
    </padding>

    <VBox spacing="4" styleClass="standard-section">
        <Label text="Tratamientos" styleClass="page-title"/>
        <Label text="Administra los tratamientos y servicios del consultorio." styleClass="page-subtitle" wrapText="true"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="standard-section">
        <Button fx:id="nuevoButton" text="+ Nuevo tratamiento" mnemonicParsing="false" styleClass="primary-button"/>
        <Button fx:id="editarButton" text="Editar" mnemonicParsing="false" styleClass="secondary-button"/>
        <Button fx:id="estadoButton" text="Desactivar" mnemonicParsing="false" styleClass="secondary-button"/>
    </HBox>

    <VBox spacing="12" VBox.vgrow="ALWAYS" styleClass="standard-section">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="buscarField" promptText="Buscar tratamiento..." maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="search-field"/>
            <Label fx:id="contadorTratamientosLabel" text="Tratamientos visibles: 0" styleClass="standard-muted"/>
        </HBox>
        <TableView fx:id="tratamientosTable" VBox.vgrow="ALWAYS" maxWidth="Infinity" styleClass="treatments-table">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                <TableColumn fx:id="nombreColumn" text="Tratamiento" prefWidth="220"/>
                <TableColumn fx:id="descripcionColumn" text="Descripción" prefWidth="320"/>
                <TableColumn fx:id="duracionColumn" text="Duración" prefWidth="120"/>
                <TableColumn fx:id="precioColumn" text="Precio" prefWidth="130"/>
                <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
