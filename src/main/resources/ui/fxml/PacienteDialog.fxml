<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="mx.dentalcare.ui.controller.PacienteDialogController"
        stylesheets="@../css/dentalcare.css"
        styleClass="root"
        spacing="20"
        prefWidth="650"
        prefHeight="500"
        minWidth="550"
        minHeight="450">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label
            fx:id="tituloLabel"
            text="Nuevo Paciente"
            styleClass="page-title"/>

    <Label
            text="Captura la información básica del paciente."
            styleClass="page-subtitle"/>

    <GridPane
            hgap="15"
            vgap="15"
            VBox.vgrow="ALWAYS">

        <columnConstraints>

            <ColumnConstraints
                    percentWidth="50"
                    hgrow="ALWAYS"/>

            <ColumnConstraints
                    percentWidth="50"
                    hgrow="ALWAYS"/>

        </columnConstraints>

        <Label
                text="Nombre(s)"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"/>

        <TextField
                fx:id="nombreField"
                promptText="Nombre"
                maxWidth="Infinity"
                GridPane.columnIndex="0"
                GridPane.rowIndex="1"
                GridPane.hgrow="ALWAYS"/>

        <Label
                text="Apellido paterno"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0"/>

        <TextField
                fx:id="apellidoPaternoField"
                promptText="Apellido paterno"
                maxWidth="Infinity"
                GridPane.columnIndex="1"
                GridPane.rowIndex="1"
                GridPane.hgrow="ALWAYS"/>

        <Label
                text="Apellido materno"
                GridPane.columnIndex="0"
                GridPane.rowIndex="2"/>

        <TextField
                fx:id="apellidoMaternoField"
                promptText="Apellido materno"
                maxWidth="Infinity"
                GridPane.columnIndex="0"
                GridPane.rowIndex="3"
                GridPane.hgrow="ALWAYS"/>

        <Label
                text="Teléfono"
                GridPane.columnIndex="1"
                GridPane.rowIndex="2"/>

        <TextField
                fx:id="telefonoField"
                promptText="Teléfono"
                maxWidth="Infinity"
                GridPane.columnIndex="1"
                GridPane.rowIndex="3"
                GridPane.hgrow="ALWAYS"/>

        <Label
                text="Correo electrónico"
                GridPane.columnIndex="0"
                GridPane.rowIndex="4"/>

        <TextField
                fx:id="emailField"
                promptText="Correo electrónico"
                maxWidth="Infinity"
                GridPane.columnIndex="0"
                GridPane.rowIndex="5"
                GridPane.columnSpan="2"
                GridPane.hgrow="ALWAYS"/>

    </GridPane>

    <Label
            fx:id="errorLabel"
            wrapText="true"
            maxWidth="Infinity"
            minHeight="35"
            styleClass="error-label"/>

    <HBox
            spacing="10"
            alignment="CENTER_RIGHT">

        <Button
                fx:id="guardarButton"
                text="Guardar"
                styleClass="primary-button"/>

        <Button
                fx:id="cancelarButton"
                text="Cancelar"
                styleClass="secondary-button"/>

    </HBox>

</VBox>