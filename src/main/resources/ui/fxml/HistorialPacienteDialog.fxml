<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="mx.dentalcare.ui.controller.HistorialPacienteController"
        stylesheets="@../css/dentalcare.css,@../css/dentalcare-overrides.css"
        styleClass="dialog-root"
        spacing="18">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <VBox spacing="4">
        <Label
                text="Historial clínico"
                styleClass="dialog-title"/>

        <Label
                fx:id="lblPaciente"
                text="Paciente"
                styleClass="page-subtitle"/>

        <Label
                fx:id="lblResumen"
                text="Sin información de historial"
                styleClass="page-subtitle"/>
    </VBox>

    <TableView
            fx:id="historialTable"
            VBox.vgrow="ALWAYS"
            styleClass="patients-table">
        <columns>
            <TableColumn
                    fx:id="fechaColumn"
                    text="Fecha"
                    prefWidth="105"/>

            <TableColumn
                    fx:id="horarioColumn"
                    text="Horario"
                    prefWidth="145"/>

            <TableColumn
                    fx:id="motivoColumn"
                    text="Motivo de consulta"
                    prefWidth="270"/>

            <TableColumn
                    fx:id="tratamientosColumn"
                    text="Tratamientos"
                    prefWidth="260"/>

            <TableColumn
                    fx:id="totalColumn"
                    text="Total"
                    prefWidth="100"/>
        </columns>
    </TableView>

    <HBox
            alignment="CENTER_RIGHT"
            spacing="10">

        <Button
                fx:id="btnDetalle"
                text="Ver detalle"
                mnemonicParsing="false"
                styleClass="primary-button"/>

        <Button
                fx:id="btnCerrar"
                text="Cerrar"
                mnemonicParsing="false"
                styleClass="secondary-button"/>
    </HBox>

</VBox>
