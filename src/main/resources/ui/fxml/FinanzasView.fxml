<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.dentalcare.ui.controller.FinanzasController"
      spacing="18"
      styleClass="content">
    <padding><Insets top="5" right="0" bottom="5" left="0"/></padding>

    <VBox spacing="4">
        <Label text="Finanzas" styleClass="page-title"/>
        <Label text="Control de cargos, pagos, anticipos y saldos pendientes del consultorio." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="12">
        <VBox spacing="3" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Ingresos de hoy" styleClass="page-subtitle"/>
            <Label fx:id="ingresosLabel" text="\$0.00" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="3" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Por cobrar" styleClass="page-subtitle"/>
            <Label fx:id="pendienteLabel" text="\$0.00" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="3" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="Cobros de hoy" styleClass="page-subtitle"/>
            <Label fx:id="cobrosHoyLabel" text="0" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Button text="Registrar pago" onAction="#registrarPago" styleClass="primary-button"/>
        <Button text="Registrar anticipo" onAction="#registrarAnticipo" styleClass="secondary-button"/>
        <Button text="Imprimir recibo" onAction="#imprimirRecibo" styleClass="secondary-button"/>
        <Button text="Ver detalle" onAction="#verDetalle" styleClass="secondary-button"/>
        <Button text="Sincronizar cargos" onAction="#sincronizarCargos" styleClass="secondary-button"/>
    </HBox>

    <Label fx:id="mensajeLabel" text="" wrapText="true" maxWidth="900" styleClass="page-subtitle"/>

    <TableView fx:id="cargosTable" VBox.vgrow="ALWAYS" styleClass="patients-table">
        <columns>
            <TableColumn fx:id="fechaColumn" text="Fecha" prefWidth="105"/>
            <TableColumn fx:id="pacienteColumn" text="Paciente" prefWidth="190"/>
            <TableColumn fx:id="conceptoColumn" text="Concepto" prefWidth="200"/>
            <TableColumn fx:id="importeColumn" text="Cargo" prefWidth="110"/>
            <TableColumn fx:id="pagadoColumn" text="Pagado" prefWidth="110"/>
            <TableColumn fx:id="pendienteColumn" text="Pendiente" prefWidth="120"/>
            <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>
