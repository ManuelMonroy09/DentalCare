<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="mx.dentalcare.ui.controller.TratamientoDialogController"
        stylesheets="@../css/dentalcare.css,@../css/ui-standard.css"
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        styleClass="standard-page">
    <content>
        <VBox spacing="16" fillWidth="true" styleClass="dialog-standard">
            <padding><Insets top="26" right="30" bottom="24" left="30"/></padding>
            <VBox spacing="4">
                <Label fx:id="tituloLabel" text="Nuevo tratamiento" styleClass="page-title"/>
                <Label text="Configura el tratamiento, su precio y duración." styleClass="page-subtitle" wrapText="true"/>
            </VBox>
            <VBox spacing="14" styleClass="standard-section">
                <VBox spacing="2">
                    <Label text="Información del tratamiento" styleClass="standard-section-title"/>
                    <Label text="Define los datos que se utilizarán al registrar tratamientos en una cita." styleClass="standard-section-subtitle" wrapText="true"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Nombre" styleClass="standard-form-label"/>
                    <TextField fx:id="nombreField" promptText="Ej. Limpieza dental" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Descripción" styleClass="standard-form-label"/>
                    <TextArea fx:id="descripcionArea" promptText="Describe brevemente el tratamiento..." prefRowCount="3" wrapText="true" maxWidth="Infinity"/>
                </VBox>
                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Precio" styleClass="standard-form-label"/>
                        <TextField fx:id="precioField" promptText="0.00" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Duración (minutos)" styleClass="standard-form-label"/>
                        <Spinner fx:id="duracionSpinner" editable="true" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
            </VBox>
            <Label fx:id="lblError" text="" wrapText="true" maxWidth="Infinity" styleClass="standard-error"/>
            <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="standard-actions">
                <Button fx:id="cancelarButton" text="Cancelar" mnemonicParsing="false" styleClass="secondary-button"/>
                <Button fx:id="guardarButton" text="Guardar" mnemonicParsing="false" styleClass="primary-button"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
