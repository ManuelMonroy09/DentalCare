<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="mx.dentalcare.ui.controller.PacienteDialogController"
        styleClass="dialog-page"
        spacing="0"
        stylesheets="@../css/dentalcare.css,@../css/ui-standard.css">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
    <VBox fillWidth="true" spacing="14" VBox.vgrow="ALWAYS" styleClass="standard-section">
        <VBox spacing="4">
            <Label fx:id="tituloLabel" text="Nuevo paciente" styleClass="page-title"/>
            <Label text="Registra la información básica del paciente." styleClass="page-subtitle" wrapText="true"/>
        </VBox>
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <VBox spacing="2">
                <Label text="Información personal" styleClass="standard-section-title"/>
                <Label text="Captura los datos necesarios para identificar y contactar al paciente." styleClass="standard-section-subtitle" wrapText="true"/>
            </VBox>
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox spacing="5" GridPane.columnIndex="0"><Label text="Nombre(s)" styleClass="standard-form-label"/><TextField fx:id="nombreField" promptText="Nombre" maxWidth="Infinity"/></VBox>
                <VBox spacing="5" GridPane.columnIndex="1"><Label text="Apellido paterno" styleClass="standard-form-label"/><TextField fx:id="apellidoPaternoField" promptText="Apellido paterno" maxWidth="Infinity"/></VBox>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label text="Apellido materno" styleClass="standard-form-label"/><TextField fx:id="apellidoMaternoField" promptText="Apellido materno" maxWidth="Infinity"/></VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Teléfono" styleClass="standard-form-label"/><TextField fx:id="telefonoField" promptText="Teléfono" maxWidth="Infinity"/></VBox>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"><Label text="Correo electrónico" styleClass="standard-form-label"/><TextField fx:id="emailField" promptText="correo@ejemplo.com" maxWidth="Infinity"/></VBox>
            </GridPane>
        </VBox>
        <Label fx:id="errorLabel" wrapText="true" maxWidth="Infinity" styleClass="standard-error"/>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="dialog-actions">
            <Button fx:id="cancelarButton" text="Cancelar" mnemonicParsing="false" styleClass="secondary-button"/>
            <Button fx:id="guardarButton" text="Guardar" mnemonicParsing="false" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
